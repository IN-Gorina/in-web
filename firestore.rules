rules_version = '2';

// The panel reads and writes Firestore only from the server, with the Admin SDK (which bypasses
// these rules). Browsers and the mobile app get no direct access to `staff`.
// Phase 3 adds rules for whatever the app reads directly; until then everything is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
