# Copy to .env.local (git-ignored) and fill in. See README → "Environment variables".

# Firebase console → Project settings → General → Your apps → Web app → SDK config.
# Public identifiers, not secrets. Inlined at build time: set them before pnpm build.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=in-gorina-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=in-gorina-staging
NEXT_PUBLIC_FIREBASE_APP_ID=

# SECRET. Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, in single quotes. Never commit it.
# Alternative: leave empty and set GOOGLE_APPLICATION_CREDENTIALS to the key file's path.
FIREBASE_SERVICE_ACCOUNT=

# SECRET. in-api's Postgres as the in_web_panel role (Supavisor session mode, port 5432):
# postgresql://in_web_panel.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=
